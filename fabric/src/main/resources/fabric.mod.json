{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "email": "info@kyronis.net",
    "homepage": "${mod_homepage}",
    "issues": "${mod_github}/issues",
    "sources": "${mod_github}"
  },
  "license": "${mod_license}",
  "icon": "${mod_icon}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.kyronis.idle_boost.fabric.IBFabric"
    ],
    "modmenu": [
      "net.kyronis.idle_boost.fabric.integration.IBModMenuImplementation"
    ]
  },
  "depends": {
    "java": ">=${java_version}",
    "minecraft": ">=${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*"
  },
  "recommends": {
    "modmenu": ">=10.0.0"
  },
  "custom": {
    "modmenu": {
      "update_checker": true,
      "links": {
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/idle-boost",
        "modmenu.modrinth": "https://modrinth.com/mod/idle-boost"
      }
    }
  }
}